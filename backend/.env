# ============================================================================
# Medicore POS: backend environment (.env). SAMPLE VALUES ONLY.
# Never commit this file to git. Generate your own secrets for production.
# ============================================================================

# --- Django ---------------------------------------------------------------
# 1 = development (relaxed security, sqlite allowed). Leave unset/0 in production.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=M_K*IP8FOEu^PyL#tf#bbXnm8!U17XBtInUN6x5pNU@QZYJ-UcJ*K7WkkLX-
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Frontend origins allowed to call the API (comma separated, no trailing slash)
CORS_ORIGINS=http://localhost:5173

# --- Database (PostgreSQL) -------------------------------------------------
# If DB_NAME is unset, settings.py falls back to sqlite (dev/tests only).
# Wallet and sales-credit row locks need PostgreSQL in production.
DB_NAME=medicore_pos
DB_USER=medicore
DB_PASSWORD=change-this-db-password
DB_HOST=localhost

# --- M-Pesa Daraja (SANDBOX values: replace for production) ---------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret
# 174379 and this passkey are Safaricom's public sandbox test credentials
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Long random string that is part of the callback URL (keeps strangers from posting fake payments)
MPESA_CALLBACK_TOKEN=-yrhKxSglrTG7F6ZwPgVN50ABgRODJi83LSsXeWRuouCK72G2S3n3g
# Public HTTPS address Safaricom can reach. Locally use a tunnel, e.g. https://abc123.ngrok-free.app
PUBLIC_API_URL=https://abc123.ngrok-free.app
